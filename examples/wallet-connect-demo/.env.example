# Keep the word "devnet" in the RPC URL: wallet adapters infer the cluster from
# the URL (Wallet Standard wallets when signing, Mobile Wallet Adapter on
# Android when authorizing) and would otherwise treat the app as mainnet-beta.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
