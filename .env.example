# Copy to .env locally. Never commit .env or keypairs.
# Devnet RPC (public endpoint is fine for the demo).
SOLANA_RPC_URL=https://api.devnet.solana.com

# Path to a local JSON keypair (solana-keygen / @solana/web3.js array format).
# Leave unset for a dry-run that does not submit a transaction.
SOLANA_PAYER_KEYPAIR=

# Optional recipient pubkeys (base58). If omitted, the demo derives three
# distinct local demo wallets and prints them (no airdrop required for dry-run).
ARTIST_PUBKEY=
STUDIO_PUBKEY=
SYNXED_PUBKEY=

# Gross settlement in atomic units. Default 20000 = $0.020 at 6 decimals
# (USDC-style micro-dollars).
AMOUNT_ATOMIC=20000

# Devnet stand-in scaling: lamports paid per atomic unit. The default 1000
# maps $0.020 -> 0.02 SOL so each recipient stays above the ~890880-lamport
# rent-exempt minimum for brand-new accounts.
LAMPORTS_PER_UNIT=1000

# Optional: base58 id of a deployed settlement program. When set, the demo
# settles through the on-chain program; when unset, it falls back to plain
# system transfers computed with the same split math. A reference deployment
# exists on devnet:
#   SETTLEMENT_PROGRAM_ID=HQtacJhd73ygr8rBg8mHpmHduhS79dFvDZqXCRhoU4HT
SETTLEMENT_PROGRAM_ID=

# Configurable 3-way split in basis points. Must sum to 10000.
ARTIST_BPS=3500
STUDIO_BPS=4000
SYNXED_BPS=2500

# N-way demo (bun run demo:nway): labels and basis points, comma separated,
# same length, bps summing to 10000, at most 8 shares. The default adds a
# listener rewards pool as a fourth share.
NWAY_LABELS=artist,studio,synxed,rewards_pool
NWAY_BPS=3500,3500,2000,1000
# Optional rewards pool wallet; generated and stored under .keys/ if unset.
REWARDS_POOL_PUBKEY=
